# CPack config of the @RTYPE_PACKAGE_PART@ package: the CPack config of the
# project, narrowed to the @RTYPE_PACKAGE_PART@ component. The package preset
# "@RTYPE_PACKAGE_PART@" points cpack at this file.
include("@CMAKE_BINARY_DIR@/CPackConfig.cmake")

set(CPACK_GENERATOR "@RTYPE_PACKAGE_GENERATORS@")
set(CPACK_PRE_BUILD_SCRIPTS "@RTYPE_PRE_BUILD_SCRIPTS@")
set(CPACK_POST_BUILD_SCRIPTS "@RTYPE_POST_BUILD_SCRIPTS@")
set(CPACK_COMPONENTS_ALL "@RTYPE_PACKAGE_PART@")
set(CPACK_COMPONENT_@RTYPE_PACKAGE_PART_UPPER@_REQUIRED ON)
set(CPACK_PACKAGE_FILE_NAME
  "R-Type-@RTYPE_PACKAGE_PART@-@PROJECT_VERSION@-@CPACK_SYSTEM_NAME@")
set(CPACK_ARCHIVE_@RTYPE_PACKAGE_PART_UPPER@_FILE_NAME
  "${CPACK_PACKAGE_FILE_NAME}")
set(CPACK_DMG_@RTYPE_PACKAGE_PART_UPPER@_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "@RTYPE_PACKAGE_TITLE@")
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "@RTYPE_PACKAGE_TITLE@")
set(CPACK_NSIS_DISPLAY_NAME "@RTYPE_PACKAGE_TITLE@")
set(CPACK_NSIS_PACKAGE_NAME "@RTYPE_PACKAGE_TITLE@")
# Start menu shortcut, to bin/r-type_<part>.exe.
set(CPACK_PACKAGE_EXECUTABLES "r-type_@RTYPE_PACKAGE_PART@"
  "@RTYPE_PACKAGE_TITLE@")
