# Example of server.cfg. Copy it to server.cfg, in the folder the server is
# started from. One command per line; '#' starts a comment.
# Every value below is the default, so this file changes nothing as it is.
# A launch option (-p, --seed, --state-rate, --database, --set <name>=<value>)
# wins over it.

# The UDP port, from 1 to 65535.
set port 4242

# The seed of the first game, from 0 to 4294967295, or 'none' to draw one.
set seed none

# The world states sent to each player per second, from 2 to 60.
set state-rate 20

# The ticks every player's input is held before it is applied, from 0 to 30.
set input-delay 3

# The SQLite file the leaderboard of this server is kept in, on a local disk;
# a name with a space goes in quotes. Empty: r-type_server_<port>.db next to
# the executable, with the port above.
set database ""

# The master this server is listed on (r-type_server --mode master), as
# http://<host>[:<port>], and the key the master gave when the host created the
# server on it. Either one empty: the server runs alone and is listed nowhere.
# Never commit a real key.
set master-url ""
set master-key ""

# The name players read in the list of servers, 1 to 32 bytes.
set server-name "R-Type server"

# Turn a module off (it is never installed, provides no service and runs no work). Refused when a module
# that stays on depends on it: storage needs network, games needs network and
# storage, lobby needs games, metrics needs games and network, master needs
# network and games, all need logger.
# module lobby off

# Load a plugin: <name>.so (Linux, macOS) or <name>.dll (Windows), built by the
# same compiler from the same sources as this server. A plugin that cannot be
# loaded stops the server. The folder is plugins/ next to the executable; a
# relative plugin-folder is read from the folder the server starts in, and comes
# before every plugin line. A plugin is a module: `module <name> off` turns it
# off.
# plugin-folder plugins
# plugin stats
