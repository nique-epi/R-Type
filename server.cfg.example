# Example of server.cfg. Copy it to server.cfg, in the folder the server is
# started from. One command per line; '#' starts a comment.
# Every value below is the default, so this file changes nothing as it is.
# A launch option (-p, --seed, --state-rate, --database, --set <name>=<value>)
# wins over it.
#
# Only the supervisor reads this file. It runs its own lines and keeps the
# lines of its games, which it writes, in their order and followed by the ones
# its launch options force, to r-type_games_<port>.cfg next to the executable;
# each game process reads that file (--configuration) and nothing else. Each
# section below says which program reads it: [supervisor] or [games].

# [supervisor] The UDP port, from 1 to 65535.
set port 4242

# [games] The seed of the first game, from 0 to 4294967295, or 'none' to draw one.
set seed none

# [games] The world states sent to each player per second, from 2 to 60.
set state-rate 20

# [games] How each world state is written: 'delta', as the difference from the
# newest one the player acknowledged, or with every entity when it acknowledged
# none or when the newest it acknowledged is more than 60 ticks older; 'full',
# every entity in every state.
set state-encoding delta

# [games] The ticks every player's input is held before it is applied, from 0 to 30.
set input-delay 3

# [games] 1 starts every game at its boss, without the waves, to test the fight:
# the ships never die, and the game is never vanilla. 0 plays the waves.
set start-at-boss 0

# [supervisor] The SQLite file the leaderboard of this server is kept in, on a local disk;
# a name with a space goes in quotes. Empty: r-type_server_<port>.db next to
# the executable, with the port above.
set database ""

# [supervisor] The master this server is listed on (r-type_server --mode master), as
# http://<host>[:<port>], and the key the master gave when the host created the
# server on it. Either one empty: the server runs alone and is listed nowhere.
# Never commit a real key.
set master-url ""
set master-key ""

# [supervisor] The IPv4 address players reach this server at, which the master
# lists. Empty: the master lists the address the registration comes from,
# 127.0.0.1 when the master runs on this machine. 0.0.0.0, a 127.x.x.x address
# and 255.255.255.255 are refused: no player reaches the server there.
set public-address ""

# [supervisor] The name players read in the list of servers and in the answer to an
# information request, 1 to 32 bytes.
set server-name "R-Type server"

# [supervisor or games] Turn a module off (it is never installed, provides no
# service and runs no work). A module the supervisor has (logger, network,
# content, supervised games, bans, supervisor lobby, information, master,
# "admin console") is turned off in the supervisor; any other name goes to the
# games. Refused when a
# module that stays on depends on it: in the supervisor, content needs
# network, supervised games needs network, bans needs supervised games,
# supervisor lobby needs network, supervised games and bans, information needs
# network and supervised games, master needs network, supervised games and
# information, admin console needs network, supervised games and bans; in a
# game, storage needs
# network, games needs network and storage, lobby needs network and games,
# metrics needs games and network, the game-statistics plugin needs network
# and games once loaded; all need logger.
# module lobby off

# [games] Load a plugin: <name>.so (Linux, macOS) or <name>.dll (Windows), built by the
# same compiler from the same sources as this server. A plugin that cannot be
# loaded stops the server. The folder is plugins/ next to the executable; a
# relative plugin-folder is read from the folder the server starts in, and comes
# before every plugin line. A plugin is a module: `module <name> off` turns it
# off.
# plugin-folder plugins
# plugin game-statistics

# [games] The CSV file the game-statistics plugin writes a row per Bydo killed to, then
# the total of each game, named after it: each game writes <name>_<its port><extension>,
# so stats.csv gives stats_50123.csv to the game on port 50123. Refused unless the
# plugin is loaded. Empty: r-type_statistics_<its port>.csv next to the executable.
# set game-statistics-file ""
