# The URL the Next.js server reaches the master at.
# MASTER_URL=http://localhost:8080
# The secret the site names itself to the master with, so the master counts the
# quota of creations per visitor. Without it, the master counts the site.
# MASTER_SITE_KEY=
# The URL of the master a host writes in server.cfg, shown on the hosting page.
# PUBLIC_MASTER_URL=https://master.rtype.app

# The GitHub repository whose latest release the download page reads.
# GITHUB_REPOSITORY=nique-epi/R-Type
# A token raises the limit of the GitHub API from 60 requests an hour per address.
# GITHUB_TOKEN=
