{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "test",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "bench",
      "inherits": "test",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-bench"
      }
    },
    {
      "name": "sanitize",
      "inherits": "test",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-sanitize"
      }
    },
    {
      "name": "modules-off",
      "inherits": "test",
      "binaryDir": "${sourceDir}/build-modules-off",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-modules-off",
        "RTYPE_MODULE_AUDIO": "OFF",
        "RTYPE_MODULE_METRICS": "OFF",
        "RTYPE_MODULE_DEBUG": "OFF",
        "RTYPE_MODULE_UPDATE": "OFF",
        "RTYPE_MODULE_MASTER_LINK": "OFF",
        "RTYPE_MODULE_ADMIN_CONSOLE": "OFF",
        "RTYPE_MODULE_CHAT": "OFF",
        "RTYPE_MODULE_PLUGINS": "OFF",
        "RTYPE_MODULE_GAME_STATISTICS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "configuration": "Debug"
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "configuration": "Release"
    },
    {
      "name": "sanitize",
      "inherits": "test",
      "configurePreset": "sanitize"
    },
    {
      "name": "modules-off",
      "inherits": "test",
      "configurePreset": "modules-off"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "inherits": "test",
      "configurePreset": "sanitize"
    },
    {
      "name": "modules-off",
      "inherits": "test",
      "configurePreset": "modules-off"
    }
  ],
  "packagePresets": [
    {
      "name": "client",
      "configurePreset": "default",
      "configFile": "CPackConfig-client.cmake",
      "configurations": [
        "Release"
      ]
    },
    {
      "name": "server",
      "inherits": "client",
      "configFile": "CPackConfig-server.cmake"
    }
  ],
  "workflowPresets": [
    {
      "name": "build",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        }
      ]
    },
    {
      "name": "test",
      "steps": [
        {
          "type": "configure",
          "name": "test"
        },
        {
          "type": "build",
          "name": "test"
        },
        {
          "type": "test",
          "name": "test"
        }
      ]
    },
    {
      "name": "sanitize",
      "steps": [
        {
          "type": "configure",
          "name": "sanitize"
        },
        {
          "type": "build",
          "name": "sanitize"
        },
        {
          "type": "test",
          "name": "sanitize"
        }
      ]
    },
    {
      "name": "modules-off",
      "steps": [
        {
          "type": "configure",
          "name": "modules-off"
        },
        {
          "type": "build",
          "name": "modules-off"
        },
        {
          "type": "test",
          "name": "modules-off"
        }
      ]
    },
    {
      "name": "package",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        },
        {
          "type": "package",
          "name": "client"
        },
        {
          "type": "package",
          "name": "server"
        }
      ]
    }
  ]
}
