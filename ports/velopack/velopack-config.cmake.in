# Imported target of the Velopack library installed by the overlay port:
# velopack::velopack, with Velopack.h and Velopack.hpp.
include(CMakeFindDependencyMacro)

get_filename_component(_velopack_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

if(NOT TARGET velopack::velopack)
  add_library(velopack::velopack @VELOPACK_LIBRARY_KIND@ IMPORTED)
  set_target_properties(velopack::velopack PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_velopack_root}/include"
    IMPORTED_LOCATION "${_velopack_root}/@VELOPACK_LOCATION@"
  )
  if(WIN32)
    set_target_properties(velopack::velopack PROPERTIES
      IMPORTED_IMPLIB "${_velopack_root}/@VELOPACK_IMPORT_LIBRARY@"
    )
  elseif(APPLE)
    set_target_properties(velopack::velopack PROPERTIES
      IMPORTED_SONAME "@rpath/libvelopack_libc.dylib"
    )
  else()
    # What the Rust standard library of the static library calls.
    find_dependency(Threads)
    set_target_properties(velopack::velopack PROPERTIES
      INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS};m"
    )
  endif()
endif()

unset(_velopack_root)
