# Example of master.cfg. Copy it to master.cfg, in the folder the master is
# started from (r-type_server --mode master). One command per line; '#' starts
# a comment. Every value below is the default, so this file changes nothing as
# it is. A launch option (-p, --database, --set <name>=<value>) wins over it.

# The TCP port the HTTP API listens on, from 1 to 65535.
set port 8080

# The SQLite file the master keeps its data in, on a local disk; a name with a
# space goes in quotes. Empty: r-type_master.db next to the executable.
set database ""

# Turn a module off (it is installed, never started). Refused when a module
# that stays on depends on it: storage and http need logger, servers needs
# storage and http.
# module http off
