# Example of master.cfg. Copy it to master.cfg, in the folder the master is
# started from (r-type_server --mode master). One command per line; '#' starts
# a comment. Every value below is the default, so this file changes nothing as
# it is. A launch option (-p, --database, --set <name>=<value>) wins over it.

# The TCP port the HTTP API listens on, from 0 to 65535; 0 lets the system
# choose a free one.
set port 8080

# The SQLite file the master keeps its data in, on a local disk; a name with a
# space goes in quotes. Empty: r-type_master.db next to the executable.
set database ""

# The secret the web site sends in X-Site-Key when it creates a server for a
# visitor: such a creation is counted under the address the site names in
# X-Site-Client-Address, so each visitor has a quota of its own. Empty: the
# master reads neither header. Draw it with `openssl rand -hex 32`, give the
# site the same value (MASTER_SITE_KEY), and keep this file private.
set site-key ""

# What the wallet of an account holds when it opens, at the first read of its
# kopecks, chips or looks (module wallet): kopecks and chips, each 0 to
# 999999. A wallet already open keeps its balances when these change.
set wallet-starting-kopecks 0
set wallet-starting-chips 500

# The casino (module casino): roulette rooms, 1 to 16, and the players each
# seats, 1 to 32. Every room plays the same rounds, on the clock: the bets
# stay open casino-betting-seconds (5 to 600), the wheel spins
# casino-spinning-seconds, then the result shows casino-result-seconds (each
# 1 to 60), and the next round opens its bets.
set casino-rooms 3
set casino-seats 8
set casino-betting-seconds 20
set casino-spinning-seconds 6
set casino-result-seconds 5

# Make the account of a nickname an admin when the master starts (module
# accounts). The account must exist; a line that names none waits for the next
# start. The key of the passwords is no setting: give it in the environment
# variable RT_PASSWORD_KEY (openssl rand -hex 32, drawn once and kept); without
# it the master does not start, unless the accounts are off (module casino off,
# then module wallet off, then module accounts off, below).
# admin ACE

# Turn a module off (it is never installed). Refused when a module
# that stays on depends on it: storage, probe and http need logger; servers
# needs storage, probe and http; leaderboard needs logger, storage, http and
# servers, and credits the games through the wallet when it is on;
# accounts needs logger, storage and http; wallet needs logger, storage, http
# and accounts, so it goes off before the accounts; casino needs logger,
# storage, http, accounts and wallet, so it goes off before the wallet.
# module http off
