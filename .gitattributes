# The fingerprints of the waves file and of the entity sheets are taken on
# their bytes: a checkout that turned their line endings into CRLF would not
# read as the shipped files.
assets/waves/waves.toml text eol=lf
assets/entities/*.toml text eol=lf
assets/entities/masks/*.txt text eol=lf

# vcpkg takes these patches only when their SHA512 matches the portfile, so
# a checkout keeps their bytes as they are.
.github/vcpkg-downloads/* -text
